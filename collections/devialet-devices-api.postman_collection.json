          "request": {
            "name": "Get device information",
            "description": {
              "content": "Query general information pertaining to the designated device — identifiers, model, firmware version, serial number, role, and device name. Minimal firmware: DOS >= 2.14. Also available as a NOTIFICATION channel in a future revision (subscriptions are not yet implemented).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "devices",
                ":deviceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "current",
                  "key": "deviceId",
                  "description": "(Required) Device identifier. The only value supported today is `current`, which refers to the dispatcher — the device that received the request."
                },
                {
                  "description": "IP address or mDNS hostname of a Devialet device on the local network.",
                  "type": "any",
